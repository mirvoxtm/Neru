{--! main !--}
{--! abort-on-error !--}
import parser/parser
import parser/eval
import vendor/bernparsec

def main() do
    for true do
        inp = input("> ")
        if inp == ":q" then
            return false
        end

        show(inp)
    end
end

def show(src) do
    e = parse_expr(src)["value"] )| eval()
    print "=> " + e
end